generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum DocumentType {
  TDS
  SDS
  CATALOGUE
  APPLICATION_NOTE
  FORMULATION_GUIDE
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?
  visual         String    @default("active")
  sortOrder      Int       @default(0)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  code           String?       @unique
  name           String
  inci           String
  description    String?
  benefits       String[]
  functions      String[]
  technicalInfo  Json?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  isSample       Boolean       @default(false)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  applications   Application[]
  solutions      Solution[]
  documents      Document[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Application {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Solution {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id        String       @id @default(cuid())
  title     String
  type      DocumentType @default(OTHER)
  fileKey   String
  fileUrl   String?
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

model Blog {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  content     String
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model QuoteRequest {
  id          String        @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  country     String
  product     String
  quantity    String
  application String?
  message     String?
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model SampleRequest {
  id          String        @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  product     String
  application String?
  quantity    String
  message     String?
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model TechnicalEnquiry {
  id                     String        @id @default(cuid())
  name                   String
  company                String
  email                  String
  product                String?
  application            String?
  formulationRequirement String?
  question               String
  attachmentKey          String?
  status                 RequestStatus @default(NEW)
  createdAt              DateTime      @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  country   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
